# ----- App -----
APP_NAME=FNAI Backend
ENVIRONMENT=development
DEBUG=true

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://fnai:fnai@localhost:5432/fnai_dev
DATABASE_URL_SYNC=postgresql://fnai:fnai@localhost:5432/fnai_dev

# ----- Redis -----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ----- Auth -----
# Change in production
JWT_SECRET=dev-only-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- Encryption（敏感数据加密）-----
# 用于加密发布目标配置中的 app_secret / app_password / cookie 等敏感字段
# 生成密钥：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 生产环境必须配置，否则启动报错；支持逗号分隔多个密钥以实现密钥轮换（第一个用于加密）
# 开发环境留空会使用临时密钥（重启后失效）
ENCRYPTION_KEY=

# ----- AI -----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ----- Storage -----
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=fnai
S3_SECRET_KEY=fnai-secret
S3_BUCKET=fnai-storage

# ----- Monitoring -----
SENTRY_DSN=

# ----- CORS -----
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]
