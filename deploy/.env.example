# =============================================
# FNAI 应用配置文件
# 复制此文件为 .env 并填写对应值
# =============================================

# ---- 数据库 ----
POSTGRES_USER=fnai
POSTGRES_PASSWORD=fnai
POSTGRES_DB=fnai_dev

# ---- 安全 ----
# 生产环境请改成随机长字符串，可用以下命令生成：
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=996f2ab4d63a5120d85b3263314d747fd8f1f646ea43a2f5fbfacc19cf6f484b

# ---- AI 接口（必填）----
# 阿里云 DashScope API Key（qwen 系列模型）
OPENAI_API_KEY=sk-sk-ec0b4c97639f4ffabca8f4d03461ba01
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_CHAT_MODEL=qwen-plus
OPENAI_EMBEDDING_MODEL=text-embedding-v2

# ---- 运行环境 ----
ENVIRONMENT=production
DEBUG=false

# ---- 跨域（一般不需要改）----
CORS_ORIGINS=["http://localhost:3000"]

# ---- 错误监控（可选，不填不影响运行）----
SENTRY_DSN=
